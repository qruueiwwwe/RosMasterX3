# 使用ROS2 Foxy作为基础镜像
FROM ros:foxy

# 设置工作目录
WORKDIR /app

# 安装Python依赖
RUN apt-get update && apt-get install -y \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir \
    numpy \
    pyserial \
    requests \
    pyyaml

# 复制ROS2驱动代码
COPY driver_ros2.py /app/

# 设置执行权限
RUN chmod +x /app/driver_ros2.py

# 设置ROS2环境
RUN echo "source /opt/ros/foxy/setup.bash" >> /root/.bashrc

# 启动命令
CMD ["python3", "/app/driver_ros2.py"] 
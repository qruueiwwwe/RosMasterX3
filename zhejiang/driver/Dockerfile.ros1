# 使用正确的镜像名称（由 osrf 维护）
FROM osrf/ros:noetic-desktop-full

# 设置工作目录
WORKDIR /app

# 安装 Python 依赖
RUN apt-get update && apt-get install -y \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir \
    numpy \
    pyserial \
    requests

# 复制 ROS1 驱动代码
COPY driver_ros1.py /app/

# 设置执行权限
RUN chmod +x /app/driver_ros1.py

# 启动命令（加载 ROS 环境后运行驱动）
CMD ["/bin/bash", "-c", "source /opt/ros/noetic/setup.bash && python3 /app/driver_ros1.py"]
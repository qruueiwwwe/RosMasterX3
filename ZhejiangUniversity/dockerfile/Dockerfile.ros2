# 构建阶段
FROM ubuntu:20.04 AS builder

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive
ARG ROS_DISTRO=foxy

# 使用国内镜像源
RUN sed -i 's/archive.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list && \
    sed -i 's/security.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list

# 安装 ROS2 仓库
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository "deb http://mirrors.aliyun.com/ros2/ubuntu/ $(lsb_release -sc) main" \
    && apt-key adv --keyserver 'hkp://keyserver.ubuntu.com:80' --recv-key C1CF6E31E6BADE8868B172B4F42ED6FBAB17C654 \
    && apt-get update

# 安装构建依赖
RUN apt-get install -y --no-install-recommends \
    python3-pip \
    python3-numpy \
    python3-yaml \
    ros-foxy-ros-base \
    ros-foxy-cv-bridge \
    ros-foxy-image-transport \
    ros-foxy-camera-info-manager \
    ros-foxy-joy \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
RUN pip3 install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple paho-mqtt flask requests

# 创建工作目录
WORKDIR /ros_ws

# 复制 ROS2 工作空间
COPY catkin_ws/src/driver_node_ros2 /ros_ws/src/driver_node_ros2/

# 构建 ROS2 工作空间
RUN /bin/bash -c "source /opt/ros/$ROS_DISTRO/setup.bash && \
    colcon build --symlink-install"

# 最终阶段
FROM ubuntu:20.04

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive
ARG ROS_DISTRO=foxy

# 使用国内镜像源
RUN sed -i 's/archive.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list && \
    sed -i 's/security.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list

# 安装 ROS2 仓库
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository "deb http://mirrors.aliyun.com/ros2/ubuntu/ $(lsb_release -sc) main" \
    && apt-key adv --keyserver 'hkp://keyserver.ubuntu.com:80' --recv-key C1CF6E31E6BADE8868B172B4F42ED6FBAB17C654 \
    && apt-get update

# 安装运行时依赖
RUN apt-get install -y --no-install-recommends \
    python3-pip \
    python3-numpy \
    python3-yaml \
    mosquitto \
    mosquitto-clients \
    ros-foxy-ros-base \
    ros-foxy-cv-bridge \
    ros-foxy-image-transport \
    ros-foxy-camera-info-manager \
    ros-foxy-joy \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
RUN pip3 install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple paho-mqtt flask requests

# 创建工作目录
WORKDIR /ros_ws

# 从构建阶段复制构建结果
COPY --from=builder /ros_ws/install /ros_ws/install
COPY --from=builder /ros_ws/build /ros_ws/build

# 复制配置文件
COPY dockerfile/params.yaml /ros_ws/config/
COPY dockerfile/http_server.py /ros_ws/scripts/
COPY dockerfile/entrypoint.sh /ros_ws/scripts/

# 设置环境变量
ENV PYTHONPATH=/ros_ws/install/lib/python3.8/site-packages:${PYTHONPATH:-}
ENV PATH=/ros_ws/install/bin:/opt/ros/$ROS_DISTRO/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/ros/$ROS_DISTRO/lib:/ros_ws/install/lib:${LD_LIBRARY_PATH:-}

# 设置入口点脚本权限
RUN chmod +x /ros_ws/scripts/entrypoint.sh

# 设置入口点
ENTRYPOINT ["/ros_ws/scripts/entrypoint.sh"]